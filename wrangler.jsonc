{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "why-cloud",
  "main": "backend/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./frontend",
    "run_worker_first": ["/api/*", "/a/*", "/health"]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "folio"
    }
  ]
}
